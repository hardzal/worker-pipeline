{
  "name": "api-nodejs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "pipeline": "tsx src/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:pipeline": "node dist/cli/index.js",
    "prebuild": "pnpm run prisma:contract:emit",
    "pretypecheck": "pnpm run prisma:contract:emit",
    "pretest": "pnpm run prisma:contract:emit",
    "prisma:contract:infer": "prisma contract infer --output prisma/schema.prisma",
    "prisma:contract:emit": "prisma contract emit",
    "prisma:db:verify": "prisma db verify",
    "prisma:db:sign": "prisma db sign",
    "prisma:db:update": "prisma db update",
    "prisma:db:migrate": "prisma db migrate",
    "prisma:migration:plan": "prisma migration plan",
    "prisma:migration:status": "prisma migration status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anvia/core": "1.3.0",
    "@anvia/openai": "1.1.3",
    "@hono/node-server": "^2.1.1",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "bullmq": "6.3.4",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "ioredis": "6.0.0",
    "pg": "^8.23.0",
    "temporal-polyfill": "^1.0.5",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "prisma": "8.0.0-rc.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  }
}
